<Window x:Class="SomaticLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SomaticLauncher.ViewModels"
        xmlns:conv="clr-namespace:SomaticLauncher.Converters"
        mc:Ignorable="d"
        Title="Somatic Launcher" Height="700" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True"/>
        <conv:BoolNotConverter x:Key="BoolNot"/>

        <!-- Pill Button Style -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accordion Item Style (Expander) -->
        <Style TargetType="Expander">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                            </Border.Effect>
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top"
                                              Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Foreground="White" FontWeight="Bold" Padding="15"
                                              HorizontalContentAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <TextBlock Text="▼" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.5" FontSize="10"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed" Focusable="false"
                                                  Margin="{TemplateBinding Padding}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1a1b2e" CornerRadius="20" Opacity="{Binding WindowOpacity}">
        <Border.Effect>
            <!-- Very subtle outer glow/shadow -->
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer info -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" MouseDown="TitleBar_MouseDown" Background="Transparent" Cursor="SizeAll">
                    <Ellipse Width="24" Height="24" Fill="#5e60ce" Margin="0,0,10,0"/>
                    <TextBlock Text="Holdings" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="SomaticLauncher" Style="{StaticResource PillButton}" Margin="0,0,10,0"/>
                    <Button Content="X" Click="Close_Click" Background="Transparent" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" Margin="20,0,20,10" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    
                    <!-- Game Section -->
                    <Expander Header="Game">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                <Button Content="..." Command="{Binding SelectGameCommand}" Style="{StaticResource PillButton}" DockPanel.Dock="Right" Width="40"/>
                                <TextBox Text="{Binding GamePath}" IsReadOnly="True" Background="#33000000" Foreground="#AAAAAA" BorderThickness="0" Padding="5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            </DockPanel>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/> <!-- Spacing -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Grid.Column="0" Content="🚀 PLAY" Command="{Binding StartGameCommand}" 
                                        Background="#4caf50" Foreground="White" Height="40" 
                                        IsEnabled="{Binding IsGameRunning, Converter={StaticResource BoolNot}}"
                                        Style="{StaticResource PillButton}"
                                        HorizontalAlignment="Stretch" Margin="0"/>
                                
                                <Button Grid.Column="2" Content="⏹ STOP" Command="{Binding StopGameCommand}" 
                                        Background="#f44336" Foreground="White" Height="40" 
                                        IsEnabled="{Binding IsGameRunning}"
                                        Style="{StaticResource PillButton}"
                                        HorizontalAlignment="Stretch" Margin="0"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                                <!-- LIVE Badge (shown when game is running) -->
                                <Border Background="#1a4caf50" 
                                        CornerRadius="8" Padding="10,5" Margin="0,0,10,0" 
                                        BorderBrush="#4caf50" BorderThickness="2"
                                        Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVis}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.8" Color="#4caf50"/>
                                    </Border.Effect>
                                    <TextBlock Text="LIVE" Foreground="#4caf50" FontWeight="Bold" FontSize="12" FontFamily="Consolas"/>
                                </Border>
                                
                                <!-- OFFLINE Badge (shown when game is stopped) -->
                                <Border Background="#1a666666" 
                                        CornerRadius="8" Padding="10,5" Margin="0,0,10,0" 
                                        BorderBrush="#666666" BorderThickness="2"
                                        Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToCollapsed}}">
                                    <TextBlock Text="OFFLINE" Foreground="#999999" FontWeight="Bold" FontSize="12" FontFamily="Consolas"/>
                                </Border>
                                
                                <TextBlock Text="{Binding UptimeText}" Foreground="#AAAAAA" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Config Section -->
                    <Expander Header="Config">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Status: " Foreground="#AAAAAA"/>
                                <TextBlock Text="Found"  Visibility="{Binding IsConfigLoaded, Converter={StaticResource BoolToVis}}" Foreground="#4caf50" FontWeight="Bold"/>
                                <TextBlock Text="Missing" Visibility="{Binding IsConfigMissing, Converter={StaticResource BoolToVis}}" Foreground="#f44336" FontWeight="Bold"/>
                                <Button Content="Create Default" Command="{Binding CreateConfigCommand}" Style="{StaticResource PillButton}" Margin="10,0,0,0" Visibility="{Binding IsConfigMissing, Converter={StaticResource BoolToVis}}" FontSize="10"/>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400" Visibility="{Binding IsConfigLoaded, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <!-- Resolution Section -->
                                    <TextBlock Text="Resolution" Foreground="White" FontWeight="Bold" Margin="0,5,0,5"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Width" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.ResolutionWidth}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Height" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.ResolutionHeight}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Idle Settings -->
                                    <Expander Header="⏱ Idle Settings" Foreground="White" IsExpanded="False" Margin="0,5">
                                        <StackPanel Margin="10,5">
                                            <TextBlock Text="Fade Duration (s)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.IdleFadeDuration}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <TextBlock Text="Prepare Lead (s)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.IdlePrepareLead}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <TextBlock Text="Min Fade (s)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.IdleMinFade}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <CheckBox Content="Crossfade Idle" IsChecked="{Binding EditableConfig.CrossfadeIdle}" Foreground="White" Margin="0,5"/>
                                            <CheckBox Content="Randomize Start on Return" IsChecked="{Binding EditableConfig.RandomizeIdleStartOnReturn}" Foreground="White" Margin="0,5"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Active Mode Settings -->
                                    <Expander Header="🎯 Active Mode Settings" Foreground="White" IsExpanded="False" Margin="0,5">
                                        <StackPanel Margin="10,5">
                                            <TextBlock Text="Fade In (s)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.ActiveFadeIn}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <TextBlock Text="Fade Out (s)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.ActiveFadeOut}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <CheckBox Content="Use Fixed Window" IsChecked="{Binding EditableConfig.ActiveUseFixedWindow}" Foreground="White" Margin="0,5"/>
                                            
                                            <TextBlock Text="Fixed Mid Hold (s)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.ActiveFixedMidHoldSeconds}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <TextBlock Text="End Hold (s)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.ActiveEndHoldSeconds}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <CheckBox Content="Click Cancels to Ambient" IsChecked="{Binding EditableConfig.ActiveClickCancelsToAmbient}" Foreground="White" Margin="0,5"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Return Settings -->
                                    <Expander Header="↩ Return Settings" Foreground="White" IsExpanded="False" Margin="0,5">
                                        <StackPanel Margin="10,5">
                                            <TextBlock Text="Return Fade (s)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.ReturnFade}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <TextBlock Text="Black Hold (s)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.ReturnBlackHold}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Audio Settings -->
                                    <Expander Header="🎵 Audio Settings" Foreground="White" IsExpanded="False" Margin="0,5">
                                        <StackPanel Margin="10,5">
                                            <TextBlock Text="Music Volume" Foreground="#AAAAAA" FontSize="10"/>
                                            <Grid>
                                                <Slider Value="{Binding EditableConfig.MusicVolume}" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,50,0"/>
                                                <TextBlock Text="{Binding EditableConfig.MusicVolume, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
                                            </Grid>
                                            
                                            <TextBlock Text="Ramp In (s)" Foreground="#AAAAAA" FontSize="10" Margin="0,5,0,0"/>
                                            <TextBox Text="{Binding EditableConfig.MusicRampIn}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <TextBlock Text="Fade In (s)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.MusicFadeIn}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <TextBlock Text="Ramp Out (s)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.MusicRampOut}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <TextBlock Text="Music Subfolder" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.MusicSubfolder}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <CheckBox Content="Sync with Active Fade" IsChecked="{Binding EditableConfig.MusicSyncWithActiveFade}" Foreground="White" Margin="0,5"/>
                                            <CheckBox Content="Auto Load from Streaming" IsChecked="{Binding EditableConfig.AutoLoadMusicFromStreaming}" Foreground="White" Margin="0,5"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Other Settings -->
                                    <Expander Header="⚙ Other Settings" Foreground="White" IsExpanded="False" Margin="0,5">
                                        <StackPanel Margin="10,5">
                                            <TextBlock Text="Panel Toggle Key (KeyCode)" Foreground="#AAAAAA" FontSize="10"/>
                                            <TextBox Text="{Binding EditableConfig.PanelToggleKey}" Background="#33000000" Foreground="White" Padding="5" BorderThickness="0" Margin="0,0,0,5"/>
                                            
                                            <CheckBox Content="Ignore Ambient While Active" IsChecked="{Binding EditableConfig.IgnoreAmbientWhileActive}" Foreground="White" Margin="0,5"/>
                                            <CheckBox Content="Enable Startup Panels" IsChecked="{Binding EditableConfig.EnableStartupPanels}" Foreground="White" Margin="0,5"/>
                                        </StackPanel>
                                    </Expander>

                                    <Button Content="💾 Save All Changes" Command="{Binding SaveConfigCommand}" Style="{StaticResource PillButton}" Background="#5e60ce" Margin="0,15,0,0" Height="35" FontWeight="Bold"/>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Expander>

                    <!-- Logs Section -->
                    <Expander Header="Logs" IsExpanded="False">
                        <ListBox ItemsSource="{Binding Logs}" Height="150" Background="#33000000" BorderThickness="0" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="11"/>
                    </Expander>

                    <!-- Settings (Launcher) -->
                    <Expander Header="Display Settings" IsExpanded="False">
                         <StackPanel>
                             <TextBlock Text="Launcher Opacity" Foreground="White"/>
                             <Slider Minimum="0.2" Maximum="1" Value="{Binding WindowOpacity}"/>
                         </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
