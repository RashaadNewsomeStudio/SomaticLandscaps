<!-- This goes into MainWindow.xaml after the Activity Log section and before the buttons -->

<!-- ARTWORK CONFIG TAB -->
<TabControl Grid.Row="5" Background="Transparent" BorderThickness="0" Margin="0,15,0,15">
    <TabItem Header="⚙️ Artwork Config">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                
                <!-- Resolution Settings -->
<Border Background="#2A2A2A" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📐 Resolution Settings" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Width:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <TextBox x:Name="ResolutionWidthBox" Grid.Column="1" Background="#1A1A1A" Foreground="White" BorderBrush="#404040" Padding="8" Text="5280"/>
                            <TextBlock Grid.Column="3" Text="Height:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <TextBox x:Name="ResolutionHeightBox" Grid.Column="4" Background="#1A1A1A" Foreground="White" BorderBrush="#404040" Padding="8" Text="1620"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Idle Animation Settings -->
                <Border Background="#2A2A2A" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💤 Idle Animation Settings" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Fade Duration (s):" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="IdleFadeDurationSlider" Grid.Column="1" Minimum="0" Maximum="10" Value="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=IdleFadeDurationSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Prepare Lead (s):" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="IdlePrepareLeadSlider" Grid.Column="1" Minimum="0" Maximum="10" Value="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=IdlePrepareLeadSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Min Fade:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="IdleMinFadeSlider" Grid.Column="1" Minimum="0" Maximum="5" Value="0.2" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=IdleMinFadeSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Crossfade Idle:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <CheckBox x:Name="CrossfadeIdleToggle" Grid.Column="1" IsChecked="True" Foreground="White" Content="Enabled"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Active Animation Settings -->
                <Border Background="#2A2A2A" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="✨ Active Animation Settings" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Fade In (s):" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="ActiveFadeInSlider" Grid.Column="1" Minimum="0" Maximum="10" Value="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=ActiveFadeInSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Fade Out (s):" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="ActiveFadeOutSlider" Grid.Column="1" Minimum="0" Maximum="10" Value="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=ActiveFadeOutSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Use Fixed Window:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ActiveUseFixedWindowToggle" Grid.Column="1" IsChecked="True" Foreground="White" Content="Enabled"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Mid Hold (s):" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="ActiveFixedMidHoldSlider" Grid.Column="1" Minimum="0" Maximum="60" Value="22.0" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=ActiveFixedMidHoldSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="End Hold (s):" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="ActiveEndHoldSlider" Grid.Column="1" Minimum="0" Maximum="5" Value="0.15" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=ActiveEndHoldSlider, Path=Value, StringFormat={}{0:F2}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.Column Definitions>
                            <TextBlock Text="Return Fade (s):" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="ReturnFadeSlider" Grid.Column="1" Minimum="0" Maximum="10" Value="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=ReturnFadeSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Black Hold (s):" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="ReturnBlackHoldSlider" Grid.Column="1" Minimum="0" Maximum="5" Value="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=ReturnBlackHoldSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Randomize on Return:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <CheckBox x:Name="RandomizeIdleStartToggle" Grid.Column="1" IsChecked="True" Foreground="White" Content="Enabled"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Music Settings -->
                <Border Background="#2A2A2A" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🎵 Music Settings" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Volume:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="MusicVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1.0" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=MusicVolumeSlider, Path=Value, StringFormat={}{0:F2}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Ramp In (s):" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="MusicRampInSlider" Grid.Column="1" Minimum="0" Maximum="10" Value="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=MusicRampInSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Fade In (s):" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="MusicFadeInSlider" Grid.Column="1" Minimum="0" Maximum="10" Value="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=MusicFadeInSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Ramp Out (s):" Foreground="#CCC" VerticalAlignment="Center"/>
                            <Slider x:Name="MusicRampOutSlider" Grid.Column="1" Minimum="0" Maximum="10" Value="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=MusicRampOutSlider, Path=Value, StringFormat={}{0:F1}}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Sync with Active Fade:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <CheckBox x:Name="MusicSyncToggle" Grid.Column="1" IsChecked="False" Foreground="White" Content="Enabled"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Auto Load from Streaming:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoLoadMusicToggle" Grid.Column="1" IsChecked="True" Foreground="White" Content="Enabled"/>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Music Subfolder:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <TextBox x:Name="MusicSubfolderBox" Grid.Column="1" Background="#1A1A1A" Foreground="White" BorderBrush="#404040" Padding="8" Text="Music"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Advanced Settings -->
                <Border Background="#2A2A2A" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🔧 Advanced Settings" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Panel Toggle Key Code:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <TextBox x:Name="PanelToggleKeyBox" Grid.Column="1" Background="#1A1A1A" Foreground="White" BorderBrush="#404040" Padding="8" Text="282"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Ignore Ambient While Active:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <CheckBox x:Name="IgnoreAmbientToggle" Grid.Column="1" IsChecked="True" Foreground="White" Content="Enabled"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Active Click Cancels to Ambient:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ActiveClickCancelsToggle" Grid.Column="1" IsChecked="False" Foreground="White" Content="Enabled"/>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Enable Startup Panels:" Foreground="#CCC" VerticalAlignment="Center"/>
                            <CheckBox x:Name="EnableStartupPanelsToggle" Grid.Column="1" IsChecked="False" Foreground="White" Content="Enabled"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Load/Save Buttons -->
                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <Button Content="📂 Load Config" Style="{StaticResource PrimaryButton}" Height="45" Margin="0,0,5,0" Click="LoadConfig_Click"/>
                    <Button Content="💾 Save Config" Style="{StaticResource PrimaryButton}" Background="#2E7D32" Height="45" Margin="5,0,0,0" Click="SaveConfig_Click"/>
                </UniformGrid>
                
            </StackPanel>
        </ScrollViewer>
    </TabItem>
</TabControl>
