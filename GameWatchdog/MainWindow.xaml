<Window x:Class="WatchdogGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Somatic Landscapes Launcher" Height="900" Width="1020"
        WindowStartupLocation="CenterScreen" Background="#1F1F1F"
        ResizeMode="CanMinimize" FontFamily="Segoe UI Variable Display, Segoe UI, Arial">
    
    <Window.Resources>
        <!-- COLORS (Lightened for better visibility) -->
        <SolidColorBrush x:Key="BgDark" Color="#121212"/>
        <SolidColorBrush x:Key="CardDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="CardBorder" Color="#333333"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="PrimaryBlueHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

        <!-- STYLES -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.4" ShadowDepth="5" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#6366F1" BlurRadius="20" Opacity="0.6" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#818CF8" Offset="0"/>
                                            <GradientStop Color="#A78BFA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#818CF8" BlurRadius="30" Opacity="0.8" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E0E7FF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" BorderThickness="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="#6366F1" BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.2">
                                            <GradientStop Color="#818CF8" Offset="0"/>
                                            <GradientStop Color="#A78BFA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#818CF8" BlurRadius="25" Opacity="0.5" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7F1D1D" Offset="0"/>
                                    <GradientStop Color="#991B1B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#DC2626" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#991B1B" Offset="0"/>
                                            <GradientStop Color="#B91C1C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#EF4444" BlurRadius="25" Opacity="0.6" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: Hero & Controls -->
        <Border Grid.Column="0" BorderBrush="#222" BorderThickness="0,0,1,0">
            <Grid Margin="50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top: Header -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                         <!-- Simple Logo Icon -->
                        <Border Width="36" Height="36" Background="#222" CornerRadius="10" Margin="0,0,12,0">
                             <TextBlock Text="SL" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Somatic Landscapes" FontSize="16" FontWeight="SemiBold" Foreground="#CCC" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="01" Foreground="{StaticResource PrimaryBlue}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Full-speed resilience. Instant visibility." 
                               FontSize="42" FontWeight="Bold" Foreground="White" LineHeight="48" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Advanced game optimization engine. Real-time performance monitoring. Seamless uptime management. Professional-grade stability." 
                               Foreground="#999" FontSize="16" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,40"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartButton" Content="🚀 Start Game" Style="{StaticResource HeroButton}" Width="180" Margin="0,0,16,0" Click="StartButton_Click"/>
                        <Button x:Name="StopButton" Content="Stop" Style="{StaticResource StopButton}" Width="100" Click="StopButton_Click" IsEnabled="False"/>
                    </StackPanel>
                    
                    <!-- Status Indicator -->
                    <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                        <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#444" Margin="0,0,10,0"/>
                        <TextBlock x:Name="StatusText" Text="Ready to launch" Foreground="#888" FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom: Danger Zone -->
                <StackPanel Grid.Row="2">
                     <Button x:Name="KillSwitchButton" Content="Emergency Kill Switch" Background="#220000" Foreground="#FF6666" 
                             Padding="15,10" BorderThickness="1" BorderBrush="#440000" HorizontalAlignment="Left" FontSize="12" Click="KillSwitchButton_Click" Cursor="Hand">
                         <Button.Template>
                             <ControlTemplate TargetType="Button">
                                 <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                     <ContentPresenter HorizontalAlignment="Center"/>
                                 </Border>
                             </ControlTemplate>
                         </Button.Template>
                     </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT PANEL: Data & Config -->
        <Grid Grid.Column="1" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Stats -->
                <RowDefinition Height="Auto"/> <!-- Config -->
                <RowDefinition Height="*"/>    <!-- Logs -->
            </Grid.RowDefinitions>

            <!-- STATS ROW (Simplified) -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- MAIN STATUS INDICATOR WITH GRAPH -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Status Icon & Text -->
                        <DockPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- Pulsing Circle -->
                            <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource SuccessGreen}" Margin="0,0,15,0" VerticalAlignment="Center">
                                 <Border.Effect>
                                     <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                 </Border.Effect>
                            </Border>
                            
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="SYSTEM STATUS" Style="{StaticResource StatLabel}" FontSize="11" FontWeight="Bold" Foreground="#444"/>
                                <TextBlock Text="MONITORING" Foreground="{StaticResource SuccessGreen}" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Heartbeat Graph -->
                        <Border Grid.Column="1" ClipToBounds="True" Background="#0A0A0A" CornerRadius="8" BorderBrush="#222" BorderThickness="1">
                            <Canvas x:Name="HeartbeatCanvas" Margin="0">
                                <Polyline x:Name="HeartbeatPolyline" Stroke="{StaticResource SuccessGreen}" StrokeThickness="2" Points=""/>
                            </Canvas>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- UPTIME ONLY -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="5,0,0,0" Width="200">
                     <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SESSION UPTIME" Style="{StaticResource StatLabel}" FontSize="11" FontWeight="Bold" Foreground="#444"/>
                        <TextBlock x:Name="UptimeText" Text="00:00:00" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- CONFIG ROW -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                 <StackPanel>
                     <Grid Margin="0,0,0,15">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="Auto"/>
                         </Grid.ColumnDefinitions>
                         <TextBlock Text="Configuration" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                         <Button Content="Edit Artwork Config ↗" Style="{StaticResource GhostButton}" Padding="25,10" MinWidth="180" FontSize="14" Click="OpenConfigEditor_Click" Grid.Column="1"/>
                     </Grid>

                     <Grid Margin="0,0,0,15">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="*"/>
                         </Grid.ColumnDefinitions>
                         
                         <StackPanel Grid.Column="0" Margin="0,0,10,0">
                             <TextBlock Text="Game Executable" Foreground="#666" Margin="0,0,0,6"/>
                             <DockPanel>
                                 <Button Content="..." Width="30" DockPanel.Dock="Right" Background="#222" Foreground="#888" BorderThickness="0" Margin="5,0,0,0" Click="BrowseButton_Click"/>
                                 <TextBox x:Name="GamePathTextBox" Style="{StaticResource InputBox}" Text="C:\..."/>
                             </DockPanel>
                         </StackPanel>

                         <StackPanel Grid.Column="1" Margin="10,0,0,0">
                             <TextBlock Text="Arguments" Foreground="#666" Margin="0,0,0,6"/>
                             <TextBox x:Name="GameArgsTextBox" Style="{StaticResource InputBox}" Text="-force-d3d11"/>
                         </StackPanel>
                     </Grid>

                     <!-- Webhook Removed -->
                 </StackPanel>
            </Border>

            <!-- LOGS ROW (Enhanced Visibility) -->
             <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="20" Opacity="1.0">
                 <Grid>
                     <TextBlock Text="System Log" Foreground="#888" FontWeight="Bold" FontSize="14" VerticalAlignment="Top"/>
                     <TextBox Grid.Row="1" x:Name="ActivityLogTextBox" Background="Transparent" Foreground="#CCC" 
                              BorderThickness="0" IsReadOnly="True" FontFamily="Consolas, Monospace" FontSize="14" 
                              Padding="0,25,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="150" Margin="0"/>
                 </Grid>
             </Border>
        </Grid>
    </Grid>
</Window>
